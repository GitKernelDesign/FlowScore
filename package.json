{
  "name": "flowscore",
  "version": "1.2.0",
  "description": "Flow-Score - gestionnaire de notes pour les enseignants",
  "author": "Flow-Score",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "com.flowscore.app",
    "productName": "Flow-Score",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/**/*",
      "icon_512.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon_512.png",
      "category": "Education",
      "artifactName": "Flow-Score-${version}.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon_512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Flow-Score-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Flow-Score-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
